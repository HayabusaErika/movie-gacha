/* 电影碰一碰 · 全局基础样式 */
page {
  --bg: #f2f2f6;
  --surface: #ffffff;
  --line: #e6e8ef;
  --line-strong: #d6d9e4;
  --text: #171a23;
  --muted: #6b7280;
  --accent: #242b36;
  --accent-soft: #eceafe;
  --accent-ink: #ffffff;
  --input-bg: #e7e7ed;
  --panel-bg: #ebecf1;
  --link: #52677d;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button {
  box-sizing: border-box;
}

.rm-btn {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

.rm-btn::after {
  border: none;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #1a1a1d;
    --surface: #25252a;
    --line: #37373e;
    --line-strong: #484850;
    --text: #f5f5f7;
    --muted: #a1a1aa;
    --accent: #d5ddec;
    --accent-soft: #353945;
    --accent-ink: #171a23;
    --input-bg: #24242a;
    --panel-bg: #1e1f22;
    --link: #adc4e4;
  }
}

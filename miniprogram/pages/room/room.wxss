.room-page {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  padding: 24rpx 24rpx 60rpx;
}

/* ---------------------------------------------------------------- 大厅 */
.lobby {
  padding: 40rpx 0 0;
  max-width: 440px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lobby-title {
  font-size: 52rpx;
  font-weight: 700;
  text-align: center;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field {
  flex: 1;
  height: 84rpx;
  min-width: 0;
  padding: 0 16rpx;
  text-align: center;
  border-radius: 18rpx;
  background: var(--input-bg, #e7e7ed);
  font-size: 28rpx;
  color: var(--text);
}

.code-input {
  letter-spacing: 3rpx;
  font-weight: 700;
  text-transform: uppercase;
}

/* ---------------------------------------------------------------- 按钮 */
button[size="mini"] {
  text-align: center;
  margin: 0;
  padding: 0;
  line-height: 1.25;
  background: transparent;
}

button::after {
  border: none;
}

button[size="mini"].mini-button {
  flex: 0 0 174rpx;
  height: 84rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

button[size="mini"].primary-button {
  height: 84rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent-ink, #fff);
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

button[size="mini"].primary-button.wide,
button[size="mini"].ghost-button.wide {
  width: 100%;
}

button[size="mini"].ghost-button {
  height: 84rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.disabled {
  opacity: .45;
}

.divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--muted);
  font-size: 22rpx;
  margin: 8rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.error-text {
  text-align: center;
  color: #c85b5b;
  font-size: 23rpx;
}

/* ---------------------------------------------------------------- 房间 */
.room {
  max-width: 520px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.room-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.room-title-group {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.room-title {
  font-size: 38rpx;
  font-weight: 700;
}

.room-code {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.room-tools, .room-actions { display: flex; width: 100%; gap: 14rpx; }
.room-tools button[size="mini"], .room-actions button[size="mini"] { flex: 1; min-width: 0; padding: 0 10rpx; }
.room-actions button[size="mini"].primary-button { background: var(--surface); color: var(--text); border: 1rpx solid var(--line-strong); }

.member-row {
  white-space: nowrap;
}

.member-list { display: flex; min-width: 100%; width: max-content; justify-content: center; gap: 10rpx; }
.member-chip {
  flex: none;
  justify-content: center;
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--text);
}

/* ---------------------------------------------------------------- 影片墙 */
.wall {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.film-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.film-poster-box {
  position: relative;
  width: 132rpx;
  height: 186rpx;
  flex: none;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--panel-bg, #eceef4);
}

.film-poster {
  width: 100%;
  height: 100%;
}

.film-poster.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--muted);
}

.film-rating {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, .55);
  color: #fff;
  font-size: 18rpx;
}

.film-body {
  justify-content: center;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.film-title {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.film-meta,
.film-by {
  font-size: 21rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.film-review {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text);
}

.empty-state {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

button[size="mini"].leave-button {
  margin-top: 10rpx;
  height: 72rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------------------------------------------------------------- 弹窗 */
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: rgba(15, 18, 30, .45);
}

.modal {
  width: 100%;
  max-width: 440px;
  max-height: 86vh;
  overflow-y: auto;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--surface);
}

.add-modal {
  padding-bottom: 24rpx;
}

.modal-title {
  text-align: center;
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.hint {
  text-align: center;
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.qr-box {
  margin: 24rpx auto 0;
  width: 360rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #fff;
}

.qr-canvas {
  width: 360rpx;
  height: 360rpx;
}

.modal-actions {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.owned-list {
  margin-top: 18rpx;
  max-height: 52vh;
}

.owned-item {
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid transparent;
}

.owned-item.picked {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.owned-poster {
  width: 92rpx;
  height: 130rpx;
  border-radius: 10rpx;
  flex: none;
  background: var(--panel-bg, #eceef4);
}

.owned-poster.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--muted);
}

.owned-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  justify-content: center;
}

.owned-title {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.owned-meta {
  font-size: 20rpx;
  color: var(--muted);
}

.owned-flag {
  font-size: 19rpx;
  color: var(--muted);
}

.review-input {
  box-sizing: border-box;
  width: 100%;
  height: 150rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--bg);
  font-size: 24rpx;
  color: var(--text);
}

.muted {
  font-size: 22rpx;
  color: var(--muted);
}

.modal-actions button[size="mini"] { flex: 1; min-width: 0; padding: 0 10rpx; }

@media (prefers-color-scheme: dark) {
    page {
        background: rgb(26, 26, 29);
        color: rgb(245, 245, 249);
    }

    button[size="mini"] {
        font-family: rgb(0, 0, 0);
    }

    button.icon-button {
        border: rgb(0, 0, 0);
        background: rgb(0, 0, 0);
        color: rgb(241, 241, 245);
        box-shadow: rgb(0, 0, 0);
    }

    button.tab {
        background: rgba(0, 0, 0, 0);
        color: rgb(103, 103, 109);
    }

    .tab.active {
        color: rgb(241, 241, 245);
    }

    .tab-count {
        color: rgb(108, 108, 115);
    }

    .search-box {
        background: rgb(34, 34, 38);
    }

    .search-icon {
        border: rgb(0, 0, 0);
    }

    .search-icon::after {
        background: rgb(111, 111, 119);
    }

    .daily-note {
        color: rgb(112, 112, 120);
    }

    .poster-card {
        color: rgb(17, 17, 17);
    }

    .poster-card.is-selected {
        box-shadow: rgb(0, 0, 0);
    }

    .poster-fallback text {
        color: rgba(17, 17, 17, 0.24);
    }

    .poster-rating {
        color: rgb(49, 37, 0);
    }

    .selected-mark {
        background: rgb(17, 17, 17);
        color: rgb(183, 204, 221);
    }

    .copy-count {
        color: rgba(17, 17, 17, 0.8);
    }

    .poster-director {
        color: rgba(17, 17, 17, 0.65);
    }

    .expand-mark {
        color: rgb(17, 17, 17);
    }

    .empty-copy {
        color: rgb(112, 112, 120);
    }

    .bottom-bar {
        border-top: rgb(0, 0, 0);
        background: rgba(26, 26, 29, 0.97);
    }

    button.draw-button, button.draw-button[disabled] {
        background: rgb(213, 221, 236);
        color: rgb(17, 17, 17);
    }

    button.trade-button, button.trade-button[disabled] {
        background: rgb(17, 17, 17);
        color: rgb(226, 226, 233);
        border: rgb(0, 0, 0);
    }

    .detail-screen {
        background: rgb(26, 26, 29);
    }

    button.select-button {
        border: rgb(0, 0, 0);
        background: rgb(17, 17, 17);
        color: rgb(225, 225, 231);
    }

    .select-button.selected {
        background: rgb(213, 221, 236);
        border-color: rgb(213, 221, 236);
        color: rgb(17, 17, 17);
    }

    .detail-context {
        color: rgb(112, 112, 120);
    }

    .expanded-card {
        border: rgb(0, 0, 0);
        background: rgb(17, 17, 17);
    }

    .rating-value {
        color: rgb(152, 114, 43);
    }

    .rating-label {
        color: rgb(109, 101, 88);
    }

    .expanded-meta {
        color: rgb(130, 130, 140);
    }

    .expanded-director {
        color: rgb(103, 103, 110);
    }

    .review-label, .review-counter {
        color: rgb(98, 98, 103);
    }

    .review-text {
        color: rgb(177, 177, 188);
    }

    .empty-review {
        color: rgb(82, 82, 89);
    }

    button.text-button {
        background: rgba(0, 0, 0, 0);
        color: rgb(132, 154, 178);
    }

    .review-input {
        border: rgb(0, 0, 0);
        background: rgb(21, 21, 23);
    }

    .detail-owned {
        color: rgb(98, 98, 103);
    }

    .btn.primary, .btn.primary[disabled] {
        background: rgb(213, 221, 236);
        color: rgb(17, 17, 17);
    }

    .btn.ghost {
        background: rgb(17, 17, 17);
        color: rgb(211, 211, 224);
        border-color: rgb(41, 41, 46);
    }

    .overlay {
        background: rgba(243, 247, 255, 0.5);
    }

    .modal {
        background: rgb(17, 17, 17);
    }

    .hint {
        color: rgb(112, 112, 120);
    }

    .search {
        border: rgb(0, 0, 0);
    }

    .status {
        color: rgb(132, 154, 178);
    }

    .fallback {
        background: rgb(32, 34, 37);
    }

    .fallback text {
        color: rgba(17, 17, 17, 0.4);
    }

    .fallback.small text {
        color: rgb(81, 87, 97);
    }

    @keyframes card-arrive {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes detail-enter {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .flip .back {
        background: rgb(0, 0, 0);
        color: rgb(30, 32, 40);
        border: rgb(0, 0, 0);
    }

    .flip .front {
        background: rgb(17, 17, 17);
    }

    .reveal-title {
        color: rgb(17, 17, 17);
    }

    .reveal-sub {
        color: rgba(17, 17, 17, 0.82);
    }

    .reveal-rate {
        color: rgb(65, 38, 0);
    }

    .draw-hint {
        color: rgb(26, 26, 29);
    }

    .col-title {
        color: rgb(131, 138, 152);
    }

    .mini-poster {
        background: rgb(28, 29, 34);
    }

    .mini-title {
        color: rgb(183, 191, 210);
    }

    .mini-review {
        color: rgb(132, 154, 178);
    }

    .nfc-core {
        background: rgb(169, 188, 213);
        color: rgb(17, 17, 17);
    }

    .ring {
        border: rgb(0, 0, 0);
    }

    @keyframes nfc-pulse {
        0% {
            transform: scale(0.45);
            opacity: 0.65;
        }

        100% {
            transform: scale(1.15);
            opacity: 0;
        }
    }

    .nfc-text {
        color: rgb(131, 138, 152);
    }

    .muted {
        color: rgb(131, 138, 152);
    }

    @media (min-width: 640px) {
        .page {
            border-right: rgb(0, 0, 0);
        }

        .detail-screen {
            background: rgb(30, 31, 34);
        }

        .detail-placeholder {
            color: rgb(112, 112, 120);
        }
    }
}

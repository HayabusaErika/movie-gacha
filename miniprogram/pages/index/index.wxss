page {
  height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    sans-serif;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}
button[size="mini"] {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 1.25;
  text-align: center;
  font-family: inherit;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.4;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  margin: 0 auto;
  overflow: hidden;
}

.topbar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 16px 13px;
}

.h1 {
  flex: 1;
  white-space: nowrap;
  font-size: 29px;
  line-height: 1.2;
  font-weight: 750;
  letter-spacing: -1px;
}
.top-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 7px;
}
button.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 44px;
  height: 44px;
  border: 0.5px solid var(--line);
  border-radius: 50%;
  background: var(--surface);
  color: var(--text);
  box-shadow:
    0 1.5px 2.5px rgba(0, 0, 0, 0.025),
    inset 0 0.5px 0.5px #fff;
}
button.add-button {
  font-size: 27px;
  font-weight: 400;
}
button.menu-button {
  width: 52px;
  border-radius: 22px;
  font-size: 15.5px;
  letter-spacing: 2px;
  text-indent: 2px;
}

.wallet-toolbar {
  flex: none;
  padding: 0 16px;
}
.tabs {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 11px;
}
button.tab {
  width: auto;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 4px 0;
  background: transparent;
  color: var(--muted);
  font-size: 13.5px;
  font-weight: 600;
}
.tab.active {
  color: var(--text);
}
.tab-count {
  font-size: 11.5px;
  font-weight: 500;
  color: var(--muted);
}
.search-box {
  display: flex;
  align-items: center;
  gap: 9px;
  height: 36px;
  border-radius: 10px;
  padding: 0 12px;
  background: var(--input-bg);
}
.search-icon {
  position: relative;
  flex: none;
  width: 11.5px;
  height: 11.5px;
  border: 1.5px solid #8b8b94;
  border-radius: 50%;
}
.search-icon::after {
  content: "";
  position: absolute;
  width: 5.5px;
  height: 1.5px;
  background: #8b8b94;
  right: -4px;
  bottom: -2px;
  transform: rotate(45deg);
  border-radius: 2px;
}
.wallet-search {
  flex: 1;
  min-width: 0;
  height: 36px;
  font-size: 12.5px;
}
.daily-note {
  display: block;
  height: 27px;
  color: var(--muted);
  font-size: 12px;
  line-height: 20px;
}

.wallet-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}
.wallet-content {
  padding: 12px 16px 16px;
}
.poster-stack {
  isolation: isolate;
}
/* 卡片高度由实际浏览区计算，后面的卡片露出片名和选择入口。 */
.poster-slot {
  position: relative;
  height: var(--stack-step, 64px);
}
.poster-slot:last-child {
  height: auto;
}
.poster-card {
  position: relative;
  width: 100%;
  height: var(--poster-height, 360px);
  overflow: hidden;
  border-radius: 13.5px;
  color: #fff;
  box-shadow:
    0 -1px 0 rgba(255, 255, 255, 0.25),
    0 -4px 12px rgba(0, 0, 0, 0.15);
  animation: card-arrive 0.32s ease-out both;
}
.poster-card.is-selected {
  box-shadow:
    0 0 0 2px #9bafc1,
    0 -4px 12px rgba(0, 0, 0, 0.15);
}
.stack-image,
.stack-backdrop,
.poster-shade,
.poster-fallback {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.stack-image {
  top: 54px;
  bottom: 54px;
  height: calc(100% - 108px);
}
.stack-backdrop {
  filter: blur(16px);
  transform: scale(1.1);
  opacity: 0.4;
}
.poster-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.12),
    transparent 60%
  );
}
.poster-fallback text {
  color: rgba(255, 255, 255, 0.24);
  font-size: 110px;
  font-weight: 600;
}
.poster-shade {
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.77),
    transparent 54px,
    transparent calc(100% - 54px),
    rgba(0, 0, 0, 0.72)
  );
}
.poster-heading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 9px;
  min-height: 52px;
  padding: 4px 14px;
}
.poster-title {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  line-height: 1.3;
  font-weight: 650;
  display: block;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  text-shadow: 0 0.5px 5px rgba(0, 0, 0, 0.2);
}
.poster-indicators {
  flex: none;
  display: flex;
  align-items: center;
  gap: 5px;
  padding-top: 0;
}
.poster-rating {
  font-size: 11.5px;
  color: #f5dfaa;
  line-height: 16px;
}
button.poster-select {
  flex: none;
  width: 72px;
  height: 44px;
  padding: 0 8px;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 22px;
  color: #fff;
  background: rgba(0, 0, 0, 0.3);
  font-size: 11px;
}
button.poster-select.selected {
  color: #242b36;
  background: #fff;
  border-color: #fff;
}
.selected-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  color: #293c4a;
  font-size: 11.5px;
  font-weight: 700;
}
.copy-count {
  color: rgba(255, 255, 255, 0.8);
  font-size: 10.5px;
}
.poster-footer {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.poster-description {
  flex: 1;
  min-width: 0;
}
.poster-meta {
  display: block;
  font-size: 12.5px;
  line-height: 1.6;
}
.poster-director {
  display: block;
  color: rgba(255, 255, 255, 0.65);
  font-size: 11px;
  margin-top: 2px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.expand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 0.5px solid rgba(255, 255, 255, 0.45);
  border-radius: 50%;
  color: #fff;
  font-size: 17px;
}

.empty-state {
  padding: 60px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.empty-title {
  font-size: 16px;
  font-weight: 600;
}
.empty-copy {
  margin-top: 8px;
  margin-bottom: 16px;
  color: #8a8a93;
  font-size: 12px;
  line-height: 1.7;
}

.bottom-bar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  border-top: 0.5px solid var(--line);
  background: var(--bg);
}
button.draw-button,
button.room-dock-button {
  width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  height: 50px;
  border-radius: 12px;
}
button.draw-button,
button.draw-button[disabled] {
  background: var(--accent);
  color: var(--accent-ink);
}
button.room-dock-button,
button.room-dock-button[disabled] {
  background: var(--surface);
  color: var(--text);
  border: 0.5px solid var(--line);
}
.dock-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 3px;
  font-size: 13.5px;
  font-weight: 600;
}
.dock-note {
  font-size: 9.5px;
  font-weight: 400;
  opacity: 0.6;
}
.room-dock-button { font-size: 13.5px; font-weight: 600; }

/* 展开态使用独立滚动区域，收起后保留海报堆叠的滚动位置。 */
.detail-screen {
  position: fixed;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  flex-direction: column;
  margin: 0;
  background: var(--bg);
  animation: detail-enter 0.25s ease-out;
}
.detail-toolbar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11px 16px;
}
.detail-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
button.detail-trade-button {
  height: 37px;
  padding: 0 14px;
  border-radius: 20px;
  color: var(--accent-ink);
  background: var(--accent);
  font-size: 12.5px;
}
button.close-button {
  font-size: 29px;
  font-weight: 300;
}
button.select-button {
  height: 37px;
  padding: 0 14px;
  border: 0.5px solid var(--line);
  border-radius: 20px;
  background: var(--surface);
  color: var(--text);
  font-size: 12.5px;
}
.select-button.selected {
  background: #242b36;
  border-color: #242b36;
  color: #fff;
}
.detail-context {
  color: var(--muted);
  font-size: 12.5px;
  padding-right: 4px;
}
.detail-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}
.detail-content {
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
  padding: 6px 20px calc(18px + env(safe-area-inset-bottom));
}
button.take-button {
  width: 100%;
  margin-top: 14px;
  height: 44px;
}
.detail-owned {
  display: block;
  text-align: center;
  color: #99999f;
  margin-top: 12px;
  font-size: 11px;
}

button.btn,
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 600;
  border: 0.5px solid transparent;
}
.btn.primary,
.btn.primary[disabled] {
  background: var(--accent);
  color: var(--accent-ink);
}
.btn.ghost {
  background: var(--surface);
  color: var(--text);
  border-color: var(--line);
}
.btn.small {
  min-height: 29px;
  padding: 0 11px;
  font-size: 11.5px;
  border-radius: 8px;
}
.btn.disabled {
  opacity: 0.4;
}
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(20, 23, 32, 0.5);
}
.modal {
  width: 100%;
  max-width: 448px;
  max-height: 86vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: 15px;
  padding: 16px;
}
.modal-title {
  display: block;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
}
.hint {
  display: block;
  margin-top: 6px;
  font-size: 11.5px;
  line-height: 1.6;
  color: var(--muted);
}
.hint.small {
  font-size: 10px;
  text-align: center;
}
.search {
  width: 100%;
  height: 40px;
  padding: 0 10px;
  border: 0.5px solid var(--line);
  background: var(--input-bg);
  border-radius: 8px;
  font-size: 12px;
  margin-top: 12px;
}
.status {
  display: block;
  margin-top: 7px;
  text-align: center;
  font-size: 11.5px;
  color: var(--link);
}
.modal-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 12px;
}
.fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6e8ed;
}
.fallback text {
  font-size: 35px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.4);
}
.fallback.small text {
  font-size: 17px;
  color: #a0a7b2;
}

@keyframes card-arrive {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes detail-enter {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 抽卡翻转 */
.draw-box {
  width: 100%;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
}
.flip {
  position: relative;
  width: 100%;
  height: 70vh;
  min-height: 360px;
  max-height: 760px;
  perspective: 800px;
}

.flip .face {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 13px;
  overflow: hidden;
  backface-visibility: hidden;
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
  box-shadow: 0 12px 30px rgba(15, 18, 30, 0.28);
}

.flip .back {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: repeating-linear-gradient(45deg, #2b2f45 0 8px, #23273a 8px 16px);
  color: #e8eaf5;
  border: 2px solid #3a4060;
}

.flip .back-mark {
  font-size: 60px;
  font-weight: 800;
  opacity: 0.85;
}
.flip .back-sub {
  font-size: 11px;
  letter-spacing: 3px;
  opacity: 0.7;
}

.flip .front {
  transform: rotateY(180deg);
  background: #fff;
}
.flip.revealed .back {
  transform: rotateY(-180deg);
}
.flip.revealed .front {
  transform: rotateY(0deg);
}

.draw-hint {
  font-size: 12px;
  color: #f2f2f6;
  min-height: 17px;
}

/* 碰一碰 */
.trade-modal {
  padding: 13px;
}
.trade-section {
  margin-top: 10px;
}
.col-title {
  display: block;
  font-size: 11px;
  color: #6b7280;
  margin-bottom: 6px;
}
.mini-row {
  white-space: nowrap;
}

.mini-pass {
  display: inline-block;
  width: 75px;
  margin-right: 7px;
  vertical-align: top;
}
.mini-poster {
  position: relative;
  width: 75px;
  height: 105px;
  border-radius: 7px;
  overflow: hidden;
  background: #eceef4;
}
.mini-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.mini-title {
  display: block;
  margin-top: 4px;
  font-size: 9.5px;
  color: #3b4252;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mini-review {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 2px;
  font-size: 8.5px;
  color: #52677d;
  line-height: 1.4;
}

.trade-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 0 3px;
}
.nfc {
  position: relative;
  width: 70px;
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nfc-core {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #36485d;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 5px 13px rgba(79, 70, 229, 0.35);
}
.ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  border: 1.5px solid #52677d;
  opacity: 0;
}
.nfc.active .ring {
  animation: nfc-pulse 1.5s ease-out infinite;
}
.nfc.active .ring:nth-child(2) {
  animation-delay: 0.75s;
}

@keyframes nfc-pulse {
  0% {
    transform: scale(0.45);
    opacity: 0.65;
  }
  100% {
    transform: scale(1.15);
    opacity: 0;
  }
}

.nfc-text {
  margin-top: 5px;
  font-size: 11.5px;
  color: #6b7280;
  text-align: center;
}
.nfc-actions {
  display: flex;
  gap: 6px;
  margin-top: 7px;
  flex-wrap: wrap;
  justify-content: center;
}
.muted {
  font-size: 11.5px;
  color: #6b7280;
}

@media (prefers-reduced-motion: reduce) {
  .poster-card,
  .detail-screen,
  .nfc.active .ring {
    animation: none;
  }
  .flip .face {
    transition: none;
  }
}

/* 字号和触控尺寸使用稳定单位，海报宽度随可用空间变化。 */
.app-layout {
  height: 100vh;
  width: 100%;
  overflow: hidden;
}
.detail-placeholder {
  display: none;
}

@media (min-width: 640px) {
  .app-layout {
    display: flex;
    max-width: 1600px;
    margin: 0 auto;
  }
  .page {
    flex: 0 0 310px;
    width: 310px;
    margin: 0;
    border-right: 1px solid #dedee5;
  }
  .topbar {
    padding-top: 24px;
    padding-bottom: 20px;
  }
  .h1 {
    font-size: 28px;
  }
  .poster-title {
    font-size: 16px;
  }
  .poster-indicators {
    gap: 4px;
  }
  .poster-rating {
    font-size: 11px;
  }
  .bottom-bar {
    padding: 16px 12px calc(16px + env(safe-area-inset-bottom));
    gap: 8px;
  }
  button.draw-button,
  button.room-dock-button {
    gap: 8px;
    height: 54px;
  }
  .dock-label {
    font-size: 14px;
  }
  .dock-note {
    font-size: 10px;
  }
  .detail-screen {
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    flex: 1;
    width: 0;
    min-width: 0;
    height: 100%;
    background: var(--panel-bg);
    animation: none;
  }
  .detail-toolbar {
    min-height: 80px;
    padding: 18px 24px;
    justify-content: flex-end;
  }
  button.close-button {
    display: none;
  }
  .detail-context {
    font-size: 14px;
  }
  .detail-content {
    max-width: 440px;
    padding: 8px 24px 32px;
  }
  .detail-placeholder {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 32px;
    color: #8a8a93;
    font-size: 15px;
  }
}

@media (min-width: 1100px) {
  .page {
    flex-basis: 360px;
    width: 360px;
  }
  .detail-toolbar {
    padding-right: 36px;
  }
  .detail-content {
    max-width: 480px;
    padding: 8px 36px 36px;
  }
  button.take-button {
    width: auto;
    min-width: 200px;
    margin-left: auto;
  }
}

/* 正反两面共用同一张票根，票面高度约为可视区域的七成。 */
.movie-ticket {
  position: relative;
  width: 100%;
  height: 70vh;
  min-height: 360px;
  max-height: 760px;
  perspective: 1400px;
  --ticket-surround: var(--bg);
}
.ticket-face,
.flip .face.draw-ticket-front {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 18px;
  background: var(--ticket-paper, #f7f4ed);
  color: var(--ticket-ink, #272a30);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  box-shadow: 0 16px 40px rgba(20, 22, 31, 0.13);
  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.25, 1);
}
.ticket-front {
  transform: rotateY(0);
}
.ticket-back {
  transform: rotateY(180deg);
  pointer-events: none;
}
.movie-ticket.flipped .ticket-front {
  transform: rotateY(-180deg);
  pointer-events: none;
}
.movie-ticket.flipped .ticket-back {
  transform: rotateY(0);
  pointer-events: auto;
}
.ticket-art {
  position: relative;
  flex: 1;
  min-height: 80px;
  overflow: hidden;
  background: var(--ticket-color, #35475c);
}
.ticket-art .poster-fallback text {
  font-size: 90px;
}
.ticket-art-background,
.ticket-poster {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.ticket-art-background {
  opacity: 0.4;
  filter: blur(18px);
  transform: scale(1.16);
}
.ticket-poster {
  padding: 8px 0;
}
.ticket-stub {
  flex: none;
  padding: 14px 18px 12px;
}
.ticket-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.ticket-title {
  flex: 1;
  min-width: 0;
  font-size: 19px;
  font-weight: 650;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ticket-rating {
  flex: none;
  font-size: 13px;
  color: var(--ticket-accent);
  line-height: 26px;
}
.ticket-meta {
  display: block;
  margin-top: 5px;
  font-size: 11px;
  line-height: 1.5;
  opacity: 0.55;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ticket-intro-label {
  display: block;
  margin-top: 10px;
  font-size: 10px;
  opacity: 0.5;
}
.ticket-intro {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 4px;
  font-size: 13px;
  line-height: 1.65;
}
.ticket-quote {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 8px;
  font-size: 11px;
  line-height: 1.6;
  opacity: 0.6;
}
.ticket-perforation {
  position: relative;
  flex: none;
  margin: 0 14px;
  border-top: 1px dashed rgba(30, 32, 38, 0.2);
}
.ticket-notch {
  position: absolute;
  top: -9px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--ticket-surround, rgba(20, 23, 32, 0.5));
}
.ticket-notch.left {
  left: -23px;
}
.ticket-notch.right {
  right: -23px;
}
.ticket-footer {
  flex: none;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 18px;
  gap: 12px;
}
.ticket-barcode {
  width: 72px;
  height: 19px;
  opacity: 0.65;
  background: repeating-linear-gradient(
    90deg,
    var(--ticket-ink) 0 1px,
    transparent 1px 3px,
    var(--ticket-ink) 3px 5px,
    transparent 5px 6px,
    var(--ticket-ink) 6px 7px,
    transparent 7px 11px
  );
}
button.ticket-flip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 40px;
  padding: 0;
  background: transparent;
  color: var(--ticket-accent);
  font-size: 13px;
  font-weight: 600;
}
.ticket-flip-button text {
  font-size: 22px;
}
.ticket-back-heading {
  flex: none;
  padding: 26px 22px 22px;
}
.ticket-back-label {
  display: block;
  font-size: 11px;
  opacity: 0.5;
}
.ticket-back-title {
  display: block;
  margin-top: 10px;
  font-size: 23px;
  line-height: 1.4;
  font-weight: 600;
}
.ticket-back-meta {
  display: block;
  margin-top: 6px;
  font-size: 12px;
  opacity: 0.5;
}
.ticket-writing {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 22px;
}
.ticket-review-input {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 80px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ticket-ink);
  font-size: 17px;
  line-height: 2;
}
.ticket-review-counter {
  flex: none;
  align-self: flex-end;
  margin-top: 10px;
  font-size: 11px;
  opacity: 0.45;
}
.ticket-review-actions {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20px;
  margin-top: 18px;
}
button.ticket-cancel-button,
button.ticket-return-button,
button.ticket-edit-button {
  min-height: 42px;
  padding: 0 8px;
  color: var(--ticket-accent);
  background: transparent;
  font-size: 13px;
}
button.ticket-save-button {
  min-height: 42px;
  padding: 0 22px;
  border-radius: 12px;
  color: var(--ticket-paper);
  background: var(--ticket-accent);
  font-size: 13px;
}
.ticket-saved-review {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  font-size: 17px;
  line-height: 2;
}
.draw-ticket-front {
  --ticket-surround: #85868b;
}

@media (min-width: 640px) {
  .movie-ticket {
    --ticket-surround: var(--panel-bg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .ticket-face {
    transition: none;
  }
}

button.exit-selection { flex: none; height: 50px; padding: 0 12px; }
.draw-hint { text-align: center; }
